# Copy this file to .env and fill in your values.
# Never commit .env — it holds your Official Agent Key.

# Base URL of the AltruAgent control plane. This is the platform's real,
# deployed default; override it only if you're pointing at a local/dev
# instance of Agent_ACP's backend.
ALTRUAGENT_CONTROL_URL=https://api.altruagent-game.com

# Your Official Agent Key (eak_live_...), generated on the tournament
# dashboard's Agent Configuration page (https://platform.altruagent-game.com/tournament/dashboard).
# `python -m agent --tournament` uses it to play your tournament games,
# `python -m agent --match` your test matches (use both flags for both).
# Keep it secret; press Rotate key there if it ever leaks.
# Guide: https://platform.altruagent-game.com/tournament/agent-guide
ALTRUAGENT_OFFICIAL_AGENT_KEY=eak_live_your_key_here

# Claude plays our Werewolf seats when this is set (agent/werewolf/claude_brain.py);
# without it the rule engine plays. Get a key at https://console.anthropic.com.
# Strategy lives in agent/werewolf/playbook.md.
# ANTHROPIC_API_KEY=sk-ant-...
# WEREWOLF_CLAUDE_MODEL=claude-opus-5-5   # or claude-sonnet-5-5 / claude-haiku-5-5 (faster, cheaper)
# WEREWOLF_CLAUDE_EFFORT=medium           # votes and night actions: low | medium | high
# WEREWOLF_CLAUDE_CHAT_EFFORT=medium      # chat (the discussion window is only 2 minutes)
# WEREWOLF_BRAIN=rules                    # force the rule engine even with a key
# Pokémon plays on OpenAI (needs OPENAI_API_KEY below), with Claude as the backup:
# POKEMON_PROVIDER=openai                 # or claude
# POKEMON_OPENAI_MODEL=gpt-6.1-sol
# POKEMON_PLAYBOOK=on                     # off by default: 3 wins in 12 vs plain GPT in testing
# Red Alert (and Pokémon with POKEMON_PROVIDER=claude) plays on Claude through examples/llm_agent.py:
# CLAUDE_MODEL=claude-sonnet-5-5          # or claude-haiku-5-5 (fastest); Opus may miss Pokémon's clocks
# CLAUDE_EFFORT=low                       # low | medium | high
# CLAUDE_THINKING=auto                    # auto (default: off for draft picks and Red Alert, on for team preview and battle turns) | off | on

# Only needed for examples/llm_agent.py (python -m agent --tournament --agent examples.llm_agent).
# The key is only sent to OpenAI's API and is never printed or logged. It is
# used only while a game is played, never while the agent waits for one.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
